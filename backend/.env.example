APP_NAME=AI Software Engineering Agent
APP_ENV=development
DEBUG=true

API_V1_PREFIX=/api/v1

GROQ_API_KEY=gsk_your_real_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

AGENT_MAX_TURNS=12
AGENT_FORMATTER_MAX_TURNS=3

DATABASE_URL=postgresql+psycopg://software_agent:software_agent@127.0.0.1:5433/software_agent

TEST_DATABASE_URL=postgresql+psycopg://software_agent_test:software_agent_test@127.0.0.1:5434/software_agent_test